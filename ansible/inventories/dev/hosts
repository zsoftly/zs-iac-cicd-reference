# Development Environment Inventory
#
# This is a static inventory example. For dynamic inventory,
# use aws_ec2 plugin (see aws_ec2.yml.example)

[webservers]
web01.dev.example.com
web02.dev.example.com

[databases]
db01.dev.example.com

[all:vars]
environment=dev
ansible_user=ec2-user
ansible_ssh_private_key_file=~/.ssh/dev-key.pem
